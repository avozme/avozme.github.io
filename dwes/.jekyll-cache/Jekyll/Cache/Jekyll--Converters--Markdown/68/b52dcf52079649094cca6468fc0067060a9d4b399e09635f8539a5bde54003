<span class="o">@</span><span class="n">app</span><span class="p">.</span><span class="n">delete</span><span class="p">(</span><span class="s">"/productos/{producto_id}"</span><span class="p">,</span> <span class="n">status_code</span><span class="o">=</span><span class="mi">204</span><span class="p">)</span>
<span class="k">def</span> <span class="nf">eliminar_producto</span><span class="p">(</span><span class="n">producto</span><span class="p">:</span> <span class="n">ProductoExistente</span><span class="p">,</span> <span class="n">db</span><span class="p">:</span> <span class="n">SesionDB</span><span class="p">):</span>
    <span class="n">db</span><span class="p">.</span><span class="n">delete</span><span class="p">(</span><span class="n">producto</span><span class="p">)</span>
    <span class="n">db</span><span class="p">.</span><span class="n">commit</span><span class="p">()</span>
